# ==================================================
# Python 基本設定 (Python generated files)
# ==================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[oc]
*.egg-info/
dist/
build/
wheels/

# ==================================================
# 仮想環境 (Virtual Environment)
# ==================================================
.venv/
venv/
env/

# ==================================================
# 環境変数・機密情報 (Secrets - NEVER COMMIT THESE)
# ==================================================
.env
.env.*
.streamlit/secrets.toml

# ==================================================
# RAG / データ関連 (Large files & Generated data)
# ==================================================
# ベクトルDBは毎回生成できるし巨大なので除外
vector_stores/

# PDFは著作権保護のため除外（ローカルで管理）
*.pdf
data/*
!data/.gitkeep

# ==================================================
# アプリケーションデータ
# ==================================================
# キャッシュフォルダ（もしあれば）
cache/

# 【重要】進捗データ
# 自分の成績をGitでバックアップしたいなら、ここはコメントアウト(#)する
# 他人に公開するなら、除外する
# progress.json

# ==================================================
# IDE / OS 設定
# ==================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini