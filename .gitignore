# ==================================================
# Python 基本設定 (Python generated files)
# ==================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[oc]
*.egg-info/
dist/
build/
wheels/

# ==================================================
# 仮想環境 (Virtual Environment)
# ==================================================
.venv/
venv/
env/

# ==================================================
# 環境変数・機密情報 (Secrets - NEVER COMMIT THESE)
# ==================================================
.env
.env.*
.streamlit/secrets.toml

# ==================================================
# RAG / データ関連 (Large files & Generated data)
# ==================================================
# ベクトルDBは毎回生成できるし巨大なので除外
vector_stores/

# PDFは著作権保護のため除外（ローカルで管理）
*.pdf
data/*
!data/.gitkeep

# ==================================================
# アプリケーションデータ
# ==================================================
# キャッシュフォルダ（もしあれば）
cache/

# 個人の進捗は下記user_data/で除外。バックアップもGit外へ保存する。

# ==================================================
# IDE / OS 設定
# ==================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
# Private runtime state and test artifacts
user_data/
models/
.study-runtime/
.pytest_cache/
.mypy_cache/
.ruff_cache/
artifacts/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
sample_data/
